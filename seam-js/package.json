{
  "name": "seam-schema",
  "version": "0.1.2",
  "description": "One schema. Every language. No drift. Native Node binding.",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "schema",
    "validation",
    "json",
    "cross-language",
    "contract"
  ],
  "repository": "https://github.com/angeldevmobile/Seam",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "seam": "cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "seam",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "test": "node --test __test__/binding.test.mjs __test__/conformance.test.mjs __test__/typegen.test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "typegen.js",
    "cli.js",
    "native.js",
    "native.d.ts",
    "*.node"
  ]
}
